# -*- coding: utf-8 -*-
"""Детектор рынка: оболочка (версия 0.8: «Отметки», «Цены», «Данные», «История», автоснимок).

Маленькая локальная программа: открывает в браузере страницу с лотами и кнопками «скрипт / ниша / нет».
В списке и неясные лоты (ждут вашей отметки), и лоты, которые правила уже признали скриптом или нишей:
фильтры «скрипт» и «ниша» показывают всё, что попадёт в итог. Отметки сохраняются в marks.csv сразу
при нажатии, по ID лота. Ваша отметка сильнее правила.
Экран «Цены»: сводка (лотов, продавцов, мин, макс, медиана), таблица лотов или продавцов и фильтры
по лотам, которые идут в итог. Сводка пересчитывается в браузере при каждом изменении фильтров.
Подписи «факт» и «оценка». Продаж и выручки нет.
Экран «Данные»: кнопка «Обновить» (один запуск fetch_category.py на нажатие, без автоповторов), состояние защиты
(по fetch_state.json) и список снимков. Каждый снимок из папки pages записывается в историю: папка history,
CSV на снимок (lots_*.csv: лоты-кандидаты, sellers_*.csv: все продавцы страницы) и index.csv.

Что она делает и чего не делает:
- слушает только этот компьютер (127.0.0.1), из сети не открывается;
- в интернет не ходит, страница не грузит ни скриптов, ни шрифтов, ни картинок (это закрыто политикой браузера);
- разбор страниц берёт из parse_category.py (read_lots, classify, add_dup_flags), своей логики разбора нет;
- читает только сохранённые страницы из папки pages, данные аккаунта не берёт и не показывает.

Экран «История» (0.8): по одному снимку на день (последний), цены по дням с графиком и теми же фильтрами, что в «Ценах»,
новые/пропавшие лоты и смена цен между двумя днями, продавцы: прирост отзывов (оценка) и метки «новый в категории» / «новый в нише».
Автоснимок (0.7): пока программа открыта, она сама запускает один загрузчик, если с прошлого запуска прошло не меньше
заданной паузы (по умолчанию 6 часов) и сегодня нет остановки. Первая проверка через 20 секунд после старта, дальше раз в 10 минут.
Перед автозапуском проверяется только DNS (есть ли сеть), запроса на сайт при этом нет. Журнал: auto_log.csv, настройки: auto_settings.json.

Запуск: двойной клик по «Запустить.bat» (или python detector_app.py).
"""
import csv, datetime, glob, hashlib, json, os, re, shutil, socket, subprocess, sys, threading, time, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

BASE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, BASE)
PAGES = os.path.join(BASE, 'pages')
MARKS = os.path.join(BASE, 'marks.csv')
MARKS_BACKUP = os.path.join(BASE, 'marks_before_shell.csv')
STATE = os.path.join(BASE, 'fetch_state.json')
FETCH_SCRIPT = os.path.join(BASE, 'fetch_category.py')
HISTORY = os.path.join(BASE, 'history')
INDEX = os.path.join(HISTORY, 'index.csv')
AUTO_CFG = os.path.join(BASE, 'auto_settings.json')
AUTO_LOG = os.path.join(BASE, 'auto_log.csv')
AUTO_DEFAULT = {'включено': True, 'пауза_часов': 6}
AUTO_LOCK = threading.Lock()
AUTO_FIRST_DELAY = float(os.environ.get('MARKET_TEST_AUTO_DELAY', '20'))
AUTO_EVERY = float(os.environ.get('MARKET_TEST_AUTO_EVERY', '600'))
INDEX_COLS = ['снимок', 'файл', 'дата', 'время', 'размер', 'лотов_на_странице', 'кандидатов', 'валюты', 'правила', 'ошибка']
LOT_COLS = ['дата', 'время', 'снимок', 'id', 'продавец', 'цена_руб', 'валюта', 'отзывов_продавца', 'на_сайте',
            'срок', 'автовыдача', 'решение', 'название']
SELLER_COLS = ['дата', 'время', 'снимок', 'продавец', 'отзывов_продавца', 'на_сайте', 'лотов_на_странице']
INDEX_LOCK = threading.Lock()
FETCH_LOCK = threading.Lock()
FETCH = {'running': False, 'lines': [], 'code': None, 'started': '', 'source': ''}
EXIT_TEXT = {
    0: 'Готово: страница сохранена, снимок добавлен в историю.',
    2: 'Остановлено: сайт показал блокировку, капчу или перенаправил на другой адрес. Загрузчик ничего не обходит; повтор сегодня запрещён.',
    3: 'Загрузка не выполнена: сегодня проход уже остановлен.',
    4: 'Остановлено: неожиданный ответ сайта (страница не отдана или в ней нет лотов).',
    5: 'Остановлено: нет связи с сайтом.',
}
HOST = '127.0.0.1'
PORTS = list(range(8765, 8786))        # сначала эти порты, если все заняты: любой свободный
VERSION = '0.9'

try:
    import parse_category as pc
except ImportError as e:
    if getattr(e, 'name', '') == 'bs4':
        print('Не установлена библиотека BeautifulSoup. В PowerShell выполните: pip install beautifulsoup4')
    else:
        print('Рядом с программой не найден parse_category.py. Положите его в ту же папку.')
    sys.exit(1)

MARK_VALUES = pc.MARK_VALUES            # ('скрипт', 'ниша', 'нет')
import account_tab as acc          # вкладка «Аккаунт»
import remind_tab as remind        # напоминания о подтверждении
import chat_tab as chat            # сообщения в «Аккаунте»
MARKS_LOCK = threading.Lock()
_cache = {}                              # (путь, время изменения) -> (неподтверждённые лоты, всего лотов)
_names = {}                              # id -> название, для записи в marks.csv


# ---------- отметки ----------
def read_marks_raw():
    """marks.csv как есть: id -> {'отметка', 'название'}. Ничего не отбрасывает."""
    rows = {}
    if os.path.exists(MARKS):
        with open(MARKS, encoding='utf-8-sig', newline='') as f:
            for r in csv.DictReader(f, delimiter=';'):
                if r.get('id'):
                    rows[r['id']] = {'отметка': r.get('отметка') or '', 'название': r.get('название') or ''}
    return rows


def set_mark(lot_id, mark):
    """Ставит или снимает отметку по ID лота. Каждый раз читает файл заново, пишет через временный файл."""
    with MARKS_LOCK:
        rows = read_marks_raw()
        if os.path.exists(MARKS) and not os.path.exists(MARKS_BACKUP):
            shutil.copyfile(MARKS, MARKS_BACKUP)         # одна копия «до оболочки», не перезаписывается
        if mark == '':
            rows.pop(lot_id, None)
        else:
            old = rows.get(lot_id, {}).get('название', '')
            rows[lot_id] = {'отметка': mark, 'название': (_names.get(lot_id) or old)[:80]}
        out = [{'id': i, 'отметка': r['отметка'], 'название': r['название']} for i, r in sorted(rows.items())]
        tmp = MARKS + '.tmp'
        try:
            pc.write_csv(tmp, ['id', 'отметка', 'название'], out)
            os.replace(tmp, MARKS)
        except OSError:
            if os.path.exists(tmp):
                try:
                    os.remove(tmp)
                except OSError:
                    pass
            raise


# ---------- страницы и лоты ----------
def list_snapshots():
    files = [p for p in glob.glob(os.path.join(PAGES, 'kategoriya_*.htm')) if os.path.isfile(p)]
    files.sort(key=os.path.getmtime, reverse=True)       # новая страница первой
    out = []
    for p in files:
        name = os.path.basename(p)
        m = re.match(r'kategoriya_(\d{4}-\d{2}-\d{2})', name)
        out.append({'name': name, 'date': m.group(1) if m else '', 'path': p})
    return out


def load_lots(path):
    """Лоты страницы: [(лот, 'rule' | 'unc')]. 'rule' = правило признало скриптом, 'unc' = неясно, ждёт отметки.
    Лоты, которые правила отбросили (чужой проект, другой срок, не рубли и т.д.), сюда не попадают."""
    key = (path, os.path.getmtime(path))
    if key in _cache:
        return _cache[key]
    seen, lots = set(), []
    for l in pc.read_lots(path):
        if l['id'] in seen:
            continue
        seen.add(l['id'])
        lots.append(l)
    items = []
    for l in lots:
        _term, reason = pc.classify(l)
        if reason is None:
            if l['валюта'] == pc.CURRENCY_OK and l['цена_руб'] is not None:
                items.append((l, 'rule'))
        elif reason.startswith('не подтверждён'):
            items.append((l, 'unc'))
    pc.add_dup_flags([l for l, _k in items])
    _cache.clear()
    _cache[key] = (items, len(lots))
    return _cache[key]


def api_lots(snap_name):
    snaps = list_snapshots()
    info = {'version': VERSION, 'snapshots': [{'name': s['name'], 'date': s['date']} for s in snaps]}
    if not snaps:
        info.update(snap='', lots=[], total=0, stale=0,
                    note='В папке pages нет сохранённых страниц. Сохраните страницу категории или запустите загрузчик fetch_category.py.')
        return info
    chosen = next((s for s in snaps if s['name'] == snap_name), snaps[0])
    items, total = load_lots(chosen['path'])
    marks = read_marks_raw()
    _names.clear()
    rows = []
    for l, kind in items:
        lid = l['id']
        _names[lid] = l['название']
        auto = ''
        if kind == 'rule':
            auto = 'ниша' if pc.is_niche(l['название']) else 'скрипт'
        manual = marks.get(lid, {}).get('отметка', '')
        if manual not in MARK_VALUES:
            manual = ''
        rows.append({'id': lid, 'title': l['название'], 'seller': l['продавец'], 'price': l['цена_руб'],
                     'cur': l['валюта'], 'reviews': l['отзывов_продавца'], 'auto_issue': l['автовыдача'],
                     'dup': l['группа_дубля'], 'kind': kind, 'auto': auto,
                     'mark': manual or auto,
                     'src': 'вручную' if manual else ('правило' if kind == 'rule' else '')})
    # по умолчанию сверху лоты без отметки, внутри групп по цене
    rows.sort(key=lambda r: (1 if r['mark'] else 0, r['price'] if r['price'] is not None else 1e18))
    ids = {r['id'] for r in rows}
    info.update(snap=chosen['name'], date=chosen['date'], lots=rows, total=total,
                stale=sum(1 for i in marks if i not in ids), note='')
    return info


def kept_lots(items, marks):
    """Какие лоты идут в итог и цены: [(лот, ниша?, 'rule'|'hand')]. Те же правила, что в parse_category.py."""
    out = []
    for l, kind in items:
        manual = marks.get(l['id'], {}).get('отметка', '')
        if manual not in MARK_VALUES:
            manual = ''
        if kind == 'rule':
            if manual == 'нет':
                continue
            niche = manual == 'ниша' or (manual != 'скрипт' and pc.is_niche(l['название']))
        else:
            if manual not in ('скрипт', 'ниша'):
                continue
            if l['валюта'] != pc.CURRENCY_OK or l['цена_руб'] is None:
                continue
            niche = manual == 'ниша'
        out.append((l, niche, 'rule' if (kind == 'rule' and not manual) else 'hand'))
    return out


def api_prices(snap_name):
    snaps = list_snapshots()
    empty = {'version': VERSION, 'snap': '', 'date': '', 'total': 0, 'kept': 0, 'sellers': 0, 'by_rule': 0,
             'by_hand': 0, 'niche': 0, 'unc_open': 0, 'lots': []}
    if not snaps:
        empty['note'] = 'В папке pages нет сохранённых страниц.'
        return empty
    chosen = next((s for s in snaps if s['name'] == snap_name), snaps[0])
    items, total = load_lots(chosen['path'])
    marks = read_marks_raw()
    kept = kept_lots(items, marks)
    copies = [dict(l) for l, _n, _s in kept]            # копии: флаги дублей здесь не должны менять экран «Отметки»
    pc.add_dup_flags(copies)
    keys, lots = {}, []
    for c, (_l, niche, src) in zip(copies, kept):
        dk = keys.setdefault(pc.dup_key(c)[0], len(keys))
        lots.append({'id': c['id'], 'title': c['название'], 'seller': c['продавец'], 'price': c['цена_руб'],
                     'reviews': c['отзывов_продавца'], 'auto_issue': c['автовыдача'], 'term': '7 дней',
                     'dup': c['группа_дубля'], 'dk': dk, 'niche': niche, 'src': src})
    unc_open = sum(1 for l, kind in items
                   if kind == 'unc' and marks.get(l['id'], {}).get('отметка', '') not in MARK_VALUES)
    return {'version': VERSION, 'snap': chosen['name'], 'date': chosen['date'], 'total': total,
            'kept': len(lots), 'sellers': len({x['seller'] for x in lots}),
            'by_rule': sum(1 for x in lots if x['src'] == 'rule'), 'by_hand': sum(1 for x in lots if x['src'] == 'hand'),
            'niche': sum(1 for x in lots if x['niche']), 'unc_open': unc_open, 'lots': lots, 'note': ''}


# ---------- защита и загрузка ----------
def protection():
    """Состояние защиты по fetch_state.json (его пишет загрузчик). Остановка действует до конца дня."""
    st = {}
    try:
        with open(STATE, encoding='utf-8') as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    day = datetime.date.today().isoformat()
    res, d = str(st.get('результат', '')), str(st.get('дата', ''))
    return {'stopped': d == day and res.startswith('остановлен'), 'date': d, 'time': str(st.get('время', '')),
            'result': res, 'reason': res.split(':', 1)[1].strip() if res.startswith('остановлен') and ':' in res else '',
            'stop_file': bool(d) and os.path.exists(os.path.join(PAGES, f'_stop_{d}.html'))}


def _fetch_worker():
    code = -1
    try:
        env = dict(os.environ, PYTHONIOENCODING='utf-8', PYTHONUTF8='1', PYTHONUNBUFFERED='1')
        pr = subprocess.Popen([sys.executable, FETCH_SCRIPT], cwd=BASE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL, text=True, encoding='utf-8', errors='replace', env=env,
                              creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
        timer = threading.Timer(900, pr.kill)       # страховка: зависший загрузчик убираем через 15 минут
        timer.daemon = True
        timer.start()
        for line in pr.stdout:
            FETCH['lines'].append(line.rstrip('\r\n'))
        code = pr.wait()
        timer.cancel()
    except Exception as e:
        FETCH['lines'].append(f'Не удалось запустить загрузчик: {type(e).__name__}: {e}')
    try:
        ensure_index()
    except Exception as e:
        FETCH['lines'].append(f'История не обновлена: {type(e).__name__}: {e}')
    try:
        auto_log(FETCH['started'], FETCH['source'], code)
    except Exception as e:
        FETCH['lines'].append(f'Журнал запусков не записан: {type(e).__name__}: {e}')
    FETCH['code'] = code
    FETCH['running'] = False


def fetch_start(source='вручную'):
    """Один запуск загрузчика на нажатие (или на автоснимок). Не стартует, если уже идёт запуск или сегодня проход остановлен."""
    with FETCH_LOCK:
        if FETCH['running']:
            return 409, {'error': 'Загрузка уже идёт, подождите.'}
        if not os.path.exists(FETCH_SCRIPT):
            return 404, {'error': 'Рядом с программой не найден fetch_category.py.'}
        pr = protection()
        if pr['stopped']:
            return 409, {'error': 'Сегодня проход остановлен (' + (pr['reason'] or pr['result']) + '). Повтор запрещён, попробуйте завтра.'}
        FETCH.update(running=True, lines=[], code=None, source=source, started=datetime.datetime.now().isoformat(timespec='seconds'))
    threading.Thread(target=_fetch_worker, daemon=True).start()
    return 200, {'ok': True}


def fetch_status():
    code = FETCH['code']
    text = ''
    if not FETCH['running'] and code is not None:
        text = EXIT_TEXT.get(code, f'Запуск завершился с кодом {code}. Подробности в тексте ниже.')
    return {'running': FETCH['running'], 'code': code, 'text': text, 'started': FETCH['started'], 'source': FETCH['source'],
            'log': '\n'.join(FETCH['lines'][-300:])}



# ---------- автоснимок ----------
def auto_read():
    cfg = dict(AUTO_DEFAULT)
    try:
        with open(AUTO_CFG, encoding='utf-8') as f:
            raw = json.load(f)
        if isinstance(raw.get('включено'), bool):
            cfg['включено'] = raw['включено']
        h = raw.get('пауза_часов')
        if isinstance(h, (int, float)) and not isinstance(h, bool) and 1 <= h <= 168:
            cfg['пауза_часов'] = h
    except (OSError, ValueError, AttributeError):
        pass
    return cfg


def auto_write(cfg):
    tmp = AUTO_CFG + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(cfg, f, ensure_ascii=False)
    os.replace(tmp, AUTO_CFG)


def last_attempt():
    """Время последней попытки загрузчика (любой: ручной или автоматической), из fetch_state.json."""
    try:
        with open(STATE, encoding='utf-8') as f:
            return datetime.datetime.fromisoformat(str(json.load(f).get('время', '')))
    except (OSError, ValueError, AttributeError):
        return None


def auto_log(started, source, code):
    text = EXIT_TEXT.get(code, f'код {code}')
    with AUTO_LOCK:
        new = not os.path.exists(AUTO_LOG)
        with open(AUTO_LOG, 'a', encoding='utf-8-sig', newline='') as f:
            w = csv.writer(f, delimiter=';')
            if new:
                w.writerow(['время', 'источник', 'код', 'результат'])
            w.writerow([started.replace('T', ' '), source, code, text])


def auto_log_tail(n=15):
    rows = []
    try:
        with open(AUTO_LOG, encoding='utf-8-sig', newline='') as f:
            rows = list(csv.DictReader(f, delimiter=';'))
    except OSError:
        pass
    return [{'time': r.get('время', ''), 'source': r.get('источник', ''), 'text': r.get('результат', '')} for r in rows[-n:][::-1]]


def auto_state():
    """(настройки, время последней попытки, когда можно, причина «не сейчас» или '')."""
    cfg, last, now = auto_read(), last_attempt(), datetime.datetime.now()
    due = last + datetime.timedelta(hours=cfg['пауза_часов']) if last else None
    if not cfg['включено']:
        why = 'выключено'
    elif protection()['stopped']:
        why = 'остановка'
    elif FETCH['running']:
        why = 'идёт загрузка'
    elif due and now < due:
        why = 'пауза'
    else:
        why = ''
    return cfg, last, due, why


def network_ok():
    """Только DNS-запрос к системе: есть ли сеть. На сайт запроса нет."""
    try:
        socket.getaddrinfo(os.environ.get('MARKET_TEST_HOST', 'funpay.com'), 443)
        return True
    except OSError:
        return False


def auto_tick():
    cfg, last, due, why = auto_state()
    if why:
        return why
    if not network_ok():
        return 'нет сети'
    code, info = fetch_start('авто')
    return '' if code == 200 else info.get('error', 'не запущено')


def auto_loop():
    time.sleep(AUTO_FIRST_DELAY)
    while True:
        try:
            auto_tick()
        except Exception:
            import traceback
            traceback.print_exc()
        time.sleep(AUTO_EVERY)


def api_auto():
    cfg, last, due, why = auto_state()
    if not cfg['включено']:
        text = 'Автоснимок выключен.'
    elif why == 'остановка':
        text = 'Сегодня проход остановлен, автоснимок не запускается до завтра.'
    elif why == 'идёт загрузка':
        text = 'Сейчас идёт загрузка.'
    elif due:
        text = ('Следующий автоснимок возможен после ' + due.strftime('%d.%m %H:%M') if why == 'пауза'
                else 'Пауза прошла: автоснимок запустится при ближайшей проверке (раз в 10 минут, пока программа открыта).')
    else:
        text = 'Запусков ещё не было: автоснимок запустится через несколько секунд после старта программы.'
    return {'enabled': cfg['включено'], 'hours': cfg['пауза_часов'], 'text': text, 'log': auto_log_tail()}


# ---------- история: по CSV на каждый снимок ----------
def rules_hash():
    parts = [str(getattr(pc, n, '')) for n in ('GAME_OK', 'TYPE_OK', 'SAMP_WORDS', 'CHEAT_WORDS', 'SCRIPT_WORDS', 'AUTO_WORDS',
                                              'AUTO_ISSUE', 'NICHE_WORDS')] + [str(getattr(pc, 'ACTIVITY_WORDS', ''))]
    return hashlib.md5('|'.join(parts).encode('utf-8')).hexdigest()[:8]


def write_atomic(path, cols, rows):
    tmp = path + '.tmp'
    pc.write_csv(tmp, cols, rows)
    os.replace(tmp, path)


def read_index():
    idx = {}
    if os.path.exists(INDEX):
        with open(INDEX, encoding='utf-8-sig', newline='') as f:
            for r in csv.DictReader(f, delimiter=';'):
                if r.get('снимок'):
                    idx[r['снимок']] = r
    return idx


def index_snapshot(snap, rh):
    """Читает страницу и пишет два файла: лоты-кандидаты (скрипты и неясные) и все продавцы страницы."""
    path, stem = snap['path'], snap['name'][:-4]
    mt = datetime.datetime.fromtimestamp(os.path.getmtime(path))
    day, hhmm = snap['date'] or mt.date().isoformat(), mt.strftime('%H:%M')
    seen, lots = set(), []
    for l in pc.read_lots(path):
        if l['id'] not in seen:
            seen.add(l['id'])
            lots.append(l)
    units = {}
    for l in lots:
        u = l['валюта'] or '(нет значка)'
        units[u] = units.get(u, 0) + 1
    cands, sellers = [], {}
    for l in lots:
        sl = sellers.setdefault(l['продавец'], {'дата': day, 'время': hhmm, 'снимок': stem, 'продавец': l['продавец'],
                                                'отзывов_продавца': l['отзывов_продавца'], 'на_сайте': l['на_сайте'],
                                                'лотов_на_странице': 0})
        sl['лотов_на_странице'] += 1
        if not sl['на_сайте'] and l['на_сайте']:
            sl['на_сайте'] = l['на_сайте']
        _term, reason = pc.classify(l)
        if reason is None or reason.startswith('не подтверждён'):
            cands.append({'дата': day, 'время': hhmm, 'снимок': stem, 'id': l['id'], 'продавец': l['продавец'],
                          'цена_руб': '' if l['цена_руб'] is None else l['цена_руб'], 'валюта': l['валюта'],
                          'отзывов_продавца': l['отзывов_продавца'], 'на_сайте': l['на_сайте'], 'срок': '7 дней',
                          'автовыдача': l['автовыдача'], 'решение': 'правило' if reason is None else 'неясно',
                          'название': l['название']})
    os.makedirs(HISTORY, exist_ok=True)
    write_atomic(os.path.join(HISTORY, 'lots_' + stem + '.csv'), LOT_COLS, cands)
    write_atomic(os.path.join(HISTORY, 'sellers_' + stem + '.csv'), SELLER_COLS, sorted(sellers.values(), key=lambda x: x['продавец']))
    return {'снимок': stem, 'файл': snap['name'], 'дата': day, 'время': hhmm, 'размер': os.path.getsize(path),
            'лотов_на_странице': len(lots), 'кандидатов': len(cands),
            'валюты': ', '.join(f'{u} {n}' for u, n in sorted(units.items(), key=lambda x: -x[1])),
            'правила': rh, 'ошибка': ''}


def ensure_index():
    """Каждая страница из pages попадает в историю. Заново читается только новая, изменившаяся или
    разобранная по старым правилам (смена parse_category.py)."""
    os.makedirs(HISTORY, exist_ok=True)
    with INDEX_LOCK:
        idx, rh, changed = read_index(), rules_hash(), False
        for snap in list_snapshots():
            stem = snap['name'][:-4]
            e = idx.get(stem)
            files_ok = all(os.path.exists(os.path.join(HISTORY, f'{k}_{stem}.csv')) for k in ('lots', 'sellers'))
            if e and not e.get('ошибка') and files_ok and str(e.get('размер')) == str(os.path.getsize(snap['path'])) \
                    and e.get('правила') == rh:
                continue
            try:
                idx[stem] = index_snapshot(snap, rh)
            except Exception as ex:
                mt = datetime.datetime.fromtimestamp(os.path.getmtime(snap['path']))
                idx[stem] = {'снимок': stem, 'файл': snap['name'], 'дата': snap['date'] or mt.date().isoformat(),
                             'время': mt.strftime('%H:%M'), 'размер': '', 'лотов_на_странице': '', 'кандидатов': '',
                             'валюты': '', 'правила': rh, 'ошибка': f'{type(ex).__name__}: {ex}'[:200]}
            changed = True
        if changed:
            write_atomic(INDEX, INDEX_COLS, [idx[k] for k in sorted(idx)])
        return idx


def read_hist_lots(stem):
    rows = []
    with open(os.path.join(HISTORY, f'lots_{stem}.csv'), encoding='utf-8-sig', newline='') as f:
        for r in csv.DictReader(f, delimiter=';'):
            r['цена_руб'] = float(r['цена_руб']) if r['цена_руб'] not in ('', None) else None
            rows.append(r)
    return rows


def hist_items(stem):
    items = []
    for r in read_hist_lots(stem):
        if r['решение'] == 'правило':
            if r['валюта'] == pc.CURRENCY_OK and r['цена_руб'] is not None:
                items.append((r, 'rule'))
        else:
            items.append((r, 'unc'))
    return items


def read_hist_sellers(stem):
    out = {}
    with open(os.path.join(HISTORY, f'sellers_{stem}.csv'), encoding='utf-8-sig', newline='') as f:
        for r in csv.DictReader(f, delimiter=';'):
            v = str(r.get('отзывов_продавца', '')).strip()
            out[r['продавец']] = [int(v) if v.isdigit() else 0, r.get('на_сайте', '')]
    return out


def _mt(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0


_hcache = {}


def api_history():
    """Один снимок на день (последний по времени). Лоты в расчёте по текущим правилам и отметкам."""
    idx = ensure_index()
    sig = (_mt(INDEX), _mt(MARKS), len(idx))
    if _hcache.get('sig') == sig:
        return _hcache['val']
    marks = read_marks_raw()
    best = {}
    for stem, e in idx.items():
        if e.get('ошибка') or not e.get('дата'):
            continue
        key = (e.get('время', ''), stem)
        if e['дата'] not in best or key > best[e['дата']][0]:
            best[e['дата']] = (key, stem)
    keys, per, union = {}, [], set()
    for date in sorted(best):
        (tm, stem) = best[date][0]
        try:
            kept = kept_lots(hist_items(stem), marks)
            page = read_hist_sellers(stem)
        except (OSError, ValueError, KeyError):
            continue
        copies = [dict(l) for l, _n, _s in kept]
        lots = []
        for c, (_l, niche, _src) in zip(copies, kept):
            dk = keys.setdefault(pc.dup_key(c)[0], len(keys))
            rv = str(c['отзывов_продавца']).strip()
            lots.append({'id': c['id'], 'title': c['название'], 'seller': c['продавец'], 'price': c['цена_руб'],
                         'reviews': int(rv) if rv.isdigit() else 0, 'auto_issue': c['автовыдача'], 'dk': dk, 'niche': niche})
        sel = {x['seller'] for x in lots}
        union |= sel
        per.append({'date': date, 'time': tm, 'stem': stem, 'total': idx[stem].get('лотов_на_странице', ''), 'lots': lots, 'sel': sel, 'page': page})
    meta = {}
    for s_name in union:
        m = {'fc': None, 'fs': None}
        for i, d in enumerate(per):
            if m['fc'] is None and s_name in d['page']:
                m['fc'] = i
            if m['fs'] is None and s_name in d['sel']:
                m['fs'] = i
        meta[s_name] = m
    days = [{'date': d['date'], 'time': d['time'], 'stem': d['stem'], 'total': d['total'], 'lots': d['lots'],
             'sellers': {n: d['page'][n] for n in union if n in d['page']}} for d in per]
    val = {'version': VERSION, 'days': days, 'meta': meta, 'snapshots': len(idx)}
    _hcache.clear()
    _hcache.update(sig=sig, val=val)
    return val


def api_data():
    idx = ensure_index()
    marks = read_marks_raw()
    day = datetime.date.today().isoformat()
    snaps = []
    for stem, e in idx.items():
        calc = ''
        if not e.get('ошибка'):
            try:
                items = hist_items(stem)
                calc = len(kept_lots(items, marks))
            except (OSError, ValueError, KeyError):
                calc = ''
        units = e.get('валюты', '')
        snaps.append({'stem': stem, 'file': e.get('файл', ''), 'date': e.get('дата', ''), 'time': e.get('время', ''),
                      'total': e.get('лотов_на_странице', ''), 'cands': e.get('кандидатов', ''), 'calc': calc,
                      'units': units, 'not_rub': bool(units) and any(not u.strip().startswith(pc.CURRENCY_OK) for u in units.split(',')),
                      'error': e.get('ошибка', ''), 'page_exists': os.path.exists(os.path.join(PAGES, e.get('файл', '')))})
    snaps.sort(key=lambda x: (x['date'], x['time']), reverse=True)
    return {'version': VERSION, 'today': day, 'protection': protection(), 'can_fetch': os.path.exists(FETCH_SCRIPT),
            'has_today': any(x['date'] == day and not x['error'] for x in snaps), 'snapshots': snaps,
            'fetch': {'running': FETCH['running']}}


# ---------- страница ----------
PAGE = r'''<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><title>Детектор рынка</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{--bg:#f6f7f9;--card:#fff;--text:#1d2530;--mut:#68727f;--line:#dde1e7;--acc:#2456a6;
--s:#1f7a45;--sbg:#e1f3e8;--n:#8a5a00;--nbg:#fbefd2;--x:#a33a3a;--xbg:#f7e3e3}
@media (prefers-color-scheme:dark){:root{--bg:#161a20;--card:#1f242c;--text:#e6e9ee;--mut:#99a3b0;--line:#323946;--acc:#7fa8e8;
--s:#7fd3a0;--sbg:#1c3a2a;--n:#e8c070;--nbg:#3b3018;--x:#ee9a9a;--xbg:#3d2323}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.45 system-ui,"Segoe UI",Arial,sans-serif}
header{display:flex;gap:18px;align-items:center;flex-wrap:wrap;padding:12px 20px;background:var(--card);border-bottom:1px solid var(--line)}
h1{font-size:18px;margin:0}
h3{font-size:15px;margin:0 0 8px}
nav{display:flex;gap:6px;flex:1}
.tab{border:0;background:none;padding:6px 12px;border-radius:6px;color:var(--text);font:inherit;cursor:pointer}
.tab:hover{background:var(--bg)}
.tab.cur{background:var(--acc);color:#fff;cursor:default}
.tab:disabled{color:var(--mut);opacity:.55;cursor:not-allowed}
.tab:disabled:hover{background:none}
main{padding:16px 20px}
.bar{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.bar label{cursor:pointer}
select,button{font:inherit;color:var(--text);background:var(--card);border:1px solid var(--line);border-radius:6px;padding:5px 10px}
button{cursor:pointer}
button:hover{border-color:var(--acc)}
.sum{color:var(--mut);margin:6px 0 12px}
.msg{display:none;padding:9px 12px;border-radius:6px;margin-bottom:10px;background:var(--nbg);color:var(--n)}
.msg.bad{background:var(--xbg);color:var(--x)}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line)}
th,td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{position:sticky;top:0;background:var(--card);font-weight:600;font-size:13px;color:var(--mut)}
td.num,th.num{text-align:right;white-space:nowrap}
td.id{color:var(--mut);font-size:12px}
td.src{color:var(--mut);font-size:13px;white-space:nowrap}
td.btns{white-space:nowrap}
.cnt{color:var(--mut);font-size:13px}
.b{margin-right:4px;padding:4px 9px}
.b.on.s{background:var(--sbg);color:var(--s);border-color:var(--s)}
.b.on.n{background:var(--nbg);color:var(--n);border-color:var(--n)}
.b.on.x{background:var(--xbg);color:var(--x);border-color:var(--x)}
tr.m-s td{background:var(--sbg)} tr.m-n td{background:var(--nbg)} tr.m-x td{background:var(--xbg);color:var(--mut)}
.tag{font-size:12px;color:var(--mut);margin-left:6px}
.empty{padding:22px;text-align:center;color:var(--mut)}
.boxes{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px;margin-bottom:14px}
.box{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.lab{display:inline-block;font-size:12px;font-weight:700;padding:1px 8px;border-radius:10px;margin-bottom:6px;text-transform:uppercase}
.lab.f{background:var(--sbg);color:var(--s)}
.lab.o{background:var(--nbg);color:var(--n)}
.card{margin-bottom:16px}
.card .note{color:var(--mut);font-size:13px;margin-top:4px}
td.med{font-weight:700}
.legend{color:var(--mut);font-size:13px;margin-top:10px}
.legend p{margin:3px 0}
.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:6px}
.sc{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 12px}
.sl{color:var(--mut);font-size:12px}
.sv{font-size:20px;font-weight:700}
details.more{margin:0 0 12px;color:var(--mut);font-size:14px}
details.more summary{cursor:pointer}
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin:12px 0}
.fg{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px}
.fh{font-weight:600;font-size:13px;color:var(--mut);margin-bottom:6px}
.fg label{display:block;margin:2px 0}
.fg .row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px}
.fg .row label{display:inline-block}
.fg input[type=number]{width:88px}
.fg input[type=text]{width:100%;margin-bottom:6px}
input[type=number],input[type=text]{font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:4px 8px}
.slist{max-height:150px;overflow:auto;border:1px solid var(--line);border-radius:6px;padding:4px 8px;background:var(--bg)}
.slist .note{color:var(--mut);font-size:13px}
.fs{color:var(--mut);font-size:13px;margin-top:6px}
.seg{border-radius:6px;margin-right:4px}
.seg.cur{background:var(--acc);color:#fff;border-color:var(--acc)}
th.srt{cursor:pointer}
.state{padding:12px 14px;border-radius:8px;font-weight:600;margin-bottom:8px}
.state.ok{background:var(--sbg);color:var(--s)}
.state.bad{background:var(--xbg);color:var(--x)}
.log{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;max-height:260px;overflow:auto;white-space:pre-wrap;font:13px/1.4 Consolas,monospace;margin:0 0 10px}
.warn{color:var(--x)}
#v-hist h3{margin-top:22px}
</style></head><body>
<header><h1>Детектор рынка</h1>
<nav><button class="tab cur" id="tab-marks" type="button">Отметки</button><button class="tab" id="tab-prices" type="button">Цены</button><button class="tab" id="tab-data" type="button">Данные</button><button class="tab" id="tab-hist" type="button">История</button></nav>
<button id="quit" type="button" title="Выключить программу">Выключить программу</button></header>
<main>
<div id="msg" class="msg"></div>
<div class="bar" id="bar-snap">
<label>Страница: <select id="snap"></select></label>
<button id="reload" type="button">Перечитать страницу</button>
</div>

<section id="v-marks">
<div class="bar">
<label><input type="radio" name="f" value="none" checked> Без отметки <span class="cnt" id="c-none"></span></label>
<label><input type="radio" name="f" value="all"> Все <span class="cnt" id="c-all"></span></label>
<label><input type="radio" name="f" value="скрипт"> скрипт <span class="cnt" id="c-s"></span></label>
<label><input type="radio" name="f" value="ниша"> ниша <span class="cnt" id="c-n"></span></label>
<label><input type="radio" name="f" value="нет"> нет <span class="cnt" id="c-x"></span></label>
</div>
<div class="sum" id="sum"></div>
<table><thead><tr><th>Отметка</th><th>Цена</th><th>Продавец</th><th>Отзывов</th><th>Название лота</th><th>Решение</th><th>ID лота</th></tr></thead>
<tbody id="rows"></tbody></table>
<div class="empty" id="empty" style="display:none"></div>
</section>

<section id="v-prices" style="display:none">
<div class="boxes">
<div class="box"><span class="lab f">факт</span><div id="p-fact"></div></div>
<div class="box"><span class="lab o">оценка</span><div id="p-est"></div></div>
</div>
<div class="summary">
<div class="sc"><div class="sl">Лотов</div><div class="sv" id="s-n">—</div></div>
<div class="sc"><div class="sl">Продавцов</div><div class="sv" id="s-sellers">—</div></div>
<div class="sc"><div class="sl">Мин. цена</div><div class="sv" id="s-min">—</div></div>
<div class="sc"><div class="sl">Макс. цена</div><div class="sv" id="s-max">—</div></div>
<div class="sc"><div class="sl">Медиана</div><div class="sv" id="s-med">—</div></div>
</div>
